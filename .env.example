# Copy this file to ".env" and fill in your own values.
# NEVER upload .env to GitHub.

# From Meta dashboard -> WhatsApp -> API Setup -> "Temporary access token" (expires in ~24 hours)
WHATSAPP_TOKEN=paste_your_token_here

# From Meta dashboard -> WhatsApp -> API Setup -> "Phone number ID" (a long number, NOT the phone number itself)
PHONE_NUMBER_ID=paste_phone_number_id_here

# Any secret word you invent. You type the same word in Meta's webhook settings.
VERIFY_TOKEN=choose_a_secret_word_here

# Graph API version. Use the version shown in your Meta dashboard's sample code.
GRAPH_API_VERSION=v25.0

# true  = practice mode: replies are NOT sent to WhatsApp, use simulate.py to chat
# false = real mode: replies go to WhatsApp through Meta
SIMULATE=true

# ---- Speech-to-text (Chunk 6). All optional; defaults shown. ----

# local  = faster-whisper on this laptop (free, private)
# hosted = Google Gemini over the internet (needs the key below; audio is sent to Google)
SPEECH_ENGINE=local

# kn = Kannada, hi = Hindi, en = English
SPEECH_LANGUAGE=kn

# Local engine: bigger = more accurate for Kannada but slower and needs more memory.
# Try medium first, then large-v3 if your GPU/RAM can handle it.
WHISPER_MODEL=medium
# auto, cpu or cuda. Use cpu if you get GPU errors.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Hosted engine only. Create your own key; never paste it into a chat or commit it.
GEMINI_API_KEY=
# Check Google's current model list before relying on this name.
SPEECH_HOSTED_MODEL=gemini-2.5-flash

# ---- Reading the transcript into ledger entries (Chunk 7). All optional; defaults shown. ----

# local  = Ollama on this laptop (free, private)
# hosted = Google Gemini (uses GEMINI_API_KEY above; the transcript is sent to Google)
EXTRACTION_ENGINE=local

# Local engine: needs Ollama running and the model downloaded (ollama pull llama3.1)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Hosted engine. Check Google's current model list before relying on this name.
EXTRACTION_HOSTED_MODEL=gemini-2.5-flash
