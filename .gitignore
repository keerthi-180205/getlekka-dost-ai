# ---- Secrets: NEVER commit these (WhatsApp token, Gemini key, ...) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# ---- Local databases (they hold shop, customer and money data) ----
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- Voice notes and recordings: they contain customers' names and amounts ----
/audio/
eval/audio/*
!eval/audio/.gitkeep
eval/reports/

# ---- Editor and system files ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Old learning notes from the first weeks (kept locally, not published) ----
WEEK*.md

# ---- Backups made while experimenting ----
*.bak
*.orig
